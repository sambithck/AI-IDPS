# Copy this file to .env and fill in your values before running.

# ── Flask ──────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-another-long-random-string

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://idps_user:idps_pass@localhost:5432/idps_db

# ── IPS / OPNsense ────────────────────────────────────────────────────────
IPS_DRY_RUN=true
OPNSENSE_HOST=https://192.168.1.1
OPNSENSE_API_KEY=
OPNSENSE_API_SECRET=
OPNSENSE_ALIAS=IDPS_BLOCKLIST

# ── Network Capture ────────────────────────────────────────────────────────
# Leave blank for default interface
CAPTURE_IFACE=

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5000
